{
  "name": "denis-durnov-portfolio-api",
  "version": "1.0.0",
  "private": true,
  "description": "GraphQL digital business card for Denis Durnov",
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "npm run db:prepare && nest start",
    "start:dev": "npm run db:prepare && nest start --watch",
    "start:debug": "npm run db:prepare && nest start --debug --watch",
    "start:prod": "npm run db:prepare && node dist/src/main.js",
    "db:prepare": "prisma db push && prisma db seed",
    "db:seed": "prisma db seed",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.2.0",
    "@nestjs/common": "^11.1.7",
    "@nestjs/core": "^11.1.7",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/platform-express": "^11.1.7",
    "@prisma/client": "^6.19.0",
    "graphql": "^16.11.0",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.12",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
