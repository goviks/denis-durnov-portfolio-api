{
  "name": "denis-durnov-portfolio-api",
  "version": "1.0.0",
  "private": true,
  "description": "GraphQL digital business card for Denis Durnov",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12 <27",
    "npm": ">=10"
  },
  "scripts": {
    "prebuild": "node scripts/ensure-env.cjs",
    "build": "prisma generate && nest build && node scripts/copy-web.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "prestart": "node scripts/ensure-env.cjs",
    "start": "npm run db:prepare && node scripts/copy-web.cjs && nest start",
    "prestart:dev": "node scripts/ensure-env.cjs",
    "start:dev": "npm run db:prepare && node scripts/copy-web.cjs && nest start --watch",
    "prestart:debug": "node scripts/ensure-env.cjs",
    "start:debug": "npm run db:prepare && node scripts/copy-web.cjs && nest start --debug --watch",
    "prestart:prod": "node scripts/ensure-env.cjs",
    "start:prod": "npm run db:prepare && node dist/src/main.js",
    "predb:prepare": "node scripts/ensure-env.cjs",
    "db:prepare": "prisma generate && prisma db push && prisma db seed",
    "db:seed": "prisma db seed",
    "test": "jest"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.2.0",
    "@nestjs/common": "^11.1.7",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.1.7",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/platform-express": "^11.1.7",
    "@prisma/client": "^6.19.0",
    "graphql": "^16.11.0",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.12",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
